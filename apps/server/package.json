{
  "name": "server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --sourcemap --outfile=dist/index.js --external:hono --external:@hono/node-server --external:pino --external:better-sqlite3 && node scripts/copy-migrations.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@tutor/contract": "workspace:*",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.3",
    "hono": "^4.13.9",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^24.19.0",
    "drizzle-kit": "0.31.11",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15"
  }
}
