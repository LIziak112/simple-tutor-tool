{
  "formatVersion": 1,
  "directives": [
    {
      "name": "question",
      "kind": "container",
      "attrs": [
        {
          "name": "type",
          "type": "judge / choice / multi / fill / solve / apply / find-error / response / matching / ordering",
          "required": true,
          "description": "题型，必填。十种取值：judge 判断 / choice 单选 / multi 多选 / fill 填空 / solve 计算 / apply 应用 / find-error 找错 / response 开放 / matching 配对 / ordering 排序（新三型的完整作答语法 TT-06 注册、导入入口受发布开关控制）；写其他值会在 lint 报错"
        },
        {
          "name": "difficulty",
          "type": "number",
          "required": false,
          "default": 2,
          "description": "难度 1–5 的整数，缺省 2；可写字符串数字（如 difficulty=3），解析时自动转换"
        },
        {
          "name": "knowledge",
          "type": "string",
          "required": false,
          "description": "考点（单个字符串），用于学情统计；解析时归一为数组入库"
        },
        {
          "name": "word-min",
          "type": "number",
          "required": false,
          "description": "response 开放题的字数提示下限（正整数，可选）：仅作答时展示提示，不硬校验、不截断"
        },
        {
          "name": "word-max",
          "type": "number",
          "required": false,
          "description": "response 开放题的字数提示上限（正整数，可选）：仅展示提示，不硬校验"
        }
      ],
      "capability": null
    },
    {
      "name": "hint",
      "kind": "container",
      "attrs": [],
      "capability": {
        "interaction": {
          "inputType": "none"
        },
        "evidence": {
          "format": "snapshot"
        }
      }
    },
    {
      "name": "answer",
      "kind": "container",
      "attrs": [],
      "capability": null
    },
    {
      "name": "solution",
      "kind": "container",
      "attrs": [],
      "capability": {
        "interaction": {
          "inputType": "none"
        },
        "evidence": {
          "format": "snapshot"
        }
      }
    },
    {
      "name": "blank",
      "kind": "text",
      "attrs": [],
      "capability": {
        "interaction": {
          "inputType": "fill"
        },
        "evidence": {
          "format": "snapshot"
        }
      }
    },
    {
      "name": "example",
      "kind": "container",
      "attrs": [
        {
          "name": "title",
          "type": "string",
          "required": false,
          "description": "例题标题，可选；缺省前端显示「例题」"
        }
      ],
      "capability": null
    },
    {
      "name": "steps",
      "kind": "container",
      "attrs": [],
      "capability": {
        "interaction": {
          "inputType": "steps"
        },
        "evidence": {
          "format": "snapshot"
        }
      }
    },
    {
      "name": "step",
      "kind": "container",
      "attrs": [
        {
          "name": "title",
          "type": "string",
          "required": false,
          "default": "",
          "description": "该步标题，缺省为空串；缺省时前端按顺序显示「第 N 步」"
        }
      ],
      "capability": null
    },
    {
      "name": "fold",
      "kind": "container",
      "attrs": [
        {
          "name": "title",
          "type": "string",
          "required": false,
          "default": "详情",
          "description": "折叠标题，缺省「详情」"
        }
      ],
      "capability": {
        "interaction": {
          "inputType": "none"
        },
        "evidence": {
          "format": "snapshot"
        }
      }
    },
    {
      "name": "tip",
      "kind": "container",
      "attrs": [
        {
          "name": "title",
          "type": "string",
          "required": false,
          "description": "标题，可选；缺省前端显示「提示」"
        }
      ],
      "capability": null
    },
    {
      "name": "warning",
      "kind": "container",
      "attrs": [
        {
          "name": "title",
          "type": "string",
          "required": false,
          "description": "标题，可选；缺省前端显示「注意」"
        }
      ],
      "capability": null
    },
    {
      "name": "box",
      "kind": "container",
      "attrs": [
        {
          "name": "title",
          "type": "string",
          "required": false,
          "description": "盒标题，可选；常与 .样式类 简写搭配（如 :::box{.warning title=\"易错点\"}）"
        }
      ],
      "capability": null
    },
    {
      "name": "columns",
      "kind": "container",
      "attrs": [],
      "capability": null
    },
    {
      "name": "col",
      "kind": "container",
      "attrs": [
        {
          "name": "width",
          "type": "string",
          "required": false,
          "description": "栏宽（如 \"40%\"、\"2fr\"），缺省各栏均分"
        }
      ],
      "capability": null
    },
    {
      "name": "mark",
      "kind": "text",
      "attrs": [
        {
          "name": "color",
          "type": "yellow / red / blue / green",
          "required": false,
          "default": "yellow",
          "description": "高亮颜色：yellow / red / blue / green，缺省 yellow"
        }
      ],
      "capability": null
    },
    {
      "name": "image",
      "kind": "leaf",
      "attrs": [
        {
          "name": "src",
          "type": "string",
          "required": true,
          "description": "图片路径，必填：写图片上传接口返回的 blobs/media/<内容哈希>.<扩展名> 路径（如 \"blobs/media/9af3….png\"），不支持外链 URL"
        },
        {
          "name": "alt",
          "type": "string",
          "required": false,
          "description": "替代文本（图片加载失败或读屏时显示），缺省「图片」"
        },
        {
          "name": "width",
          "type": "string",
          "required": false,
          "description": "显示宽度（如 \"60%\"、\"320px\"），缺省自适应"
        }
      ],
      "capability": null
    },
    {
      "name": "graph",
      "kind": "leaf",
      "attrs": [
        {
          "name": "fn",
          "type": "string",
          "required": true,
          "description": "函数表达式，必填，如 \"x^2\"、\"sin(x)\""
        },
        {
          "name": "range",
          "type": "string",
          "required": false,
          "description": "x 轴范围（如 \"-3,3\"），缺省自动选取"
        }
      ],
      "capability": null
    },
    {
      "name": "material",
      "kind": "container",
      "attrs": [
        {
          "name": "title",
          "type": "string",
          "required": false,
          "description": "材料显示标题，可选（如「给定资料一」）"
        }
      ],
      "capability": null
    },
    {
      "name": "group",
      "kind": "container",
      "attrs": [
        {
          "name": "title",
          "type": "string",
          "required": false,
          "description": "组标题，可选（公共说明的标题行；说明正文写在容器内）"
        },
        {
          "name": "label",
          "type": "string",
          "required": false,
          "description": "组级显示编号说明，可选（如「1～5」「1–20」）"
        }
      ],
      "capability": null
    },
    {
      "name": "seg",
      "kind": "container",
      "attrs": [],
      "capability": null
    },
    {
      "name": "ref",
      "kind": "leaf",
      "attrs": [
        {
          "name": "material",
          "type": "string",
          "required": false,
          "description": "被引用的材料 id（材料引用时写，与 question 互斥）"
        },
        {
          "name": "question",
          "type": "string",
          "required": false,
          "description": "被引用的子题 id（组内子题引用时写，与 material 互斥）"
        },
        {
          "name": "segs",
          "type": "string",
          "required": false,
          "description": "片段选择，可选：seg-2 单个 / seg-1..seg-3 区间 / seg-1,seg-4 列表；缺省为材料全文"
        },
        {
          "name": "slot",
          "type": "string",
          "required": false,
          "description": "单个槽位绑定，可选：子题绑定该材料的某个槽位作答（完形逐空绑定）"
        },
        {
          "name": "slots",
          "type": "string",
          "required": false,
          "description": "槽位集合，可选：matching 题声明其槽位区间/列表（如 slot-1..slot-5）"
        }
      ],
      "capability": null
    },
    {
      "name": "options",
      "kind": "container",
      "attrs": [
        {
          "name": "allow-repeat",
          "type": "string",
          "required": false,
          "default": false,
          "description": "同一选项可否被多个槽位占用，缺省 false；写 allow-repeat=true 开启（字符串布尔）"
        }
      ],
      "capability": null
    },
    {
      "name": "option",
      "kind": "container",
      "attrs": [],
      "capability": null
    },
    {
      "name": "item",
      "kind": "container",
      "attrs": [
        {
          "name": "fixed",
          "type": "string",
          "required": false,
          "default": false,
          "description": "固定项标记，缺省 false：写 fixed=true 锁定该项显示位置（位置由参考答案行序定义）"
        },
        {
          "name": "distractor",
          "type": "string",
          "required": false,
          "default": false,
          "description": "干扰项标记，缺省 false：写 distractor=true 声明该项不属于正确序列；未显式声明时解析从参考序列推导（不在序列即干扰项）"
        }
      ],
      "capability": null
    },
    {
      "name": "variant",
      "kind": "container",
      "attrs": [],
      "capability": null
    }
  ],
  "questionTypes": {
    "judge": {
      "inputType": "choice",
