{
  "title": "simple-tutor-tool 单题复习包（review-pack）",
  "description": "单题完整导出 pack.json 的权威 JSON Schema（T6R.13）。学生包不携带真实 attemptId/studentId/questionId/versionId 等定位键，也不含参考答案/判定/评语/解析——该不变量由服务端 Zod superRefine 在生成侧强制（本 JSON Schema 不含这条跨字段约束，只描述字段形状）；教师包为教师域文档，照常携带。manifest 复用学情数据包 v2 的清单形状（files + missing + contextNotes），所有引用可解析或显式缺失。",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "const": "review-pack"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "role": {
      "type": "string",
      "enum": [
        "student",
        "teacher"
      ]
    },
    "generatedAt": {
      "type": "string",
      "minLength": 1
    },
    "question": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^q\\d{3,}$"
        },
        "no": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "present": {
          "type": "boolean"
        },
        "snapshotHash": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "type": {
          "type": "string",
          "enum": [
            "judge",
            "choice",
            "multi",
            "fill",
            "solve",
            "apply",
            "find-error"
          ]
        },
        "difficulty": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "knowledge": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "stemMd": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "questionId": {
          "type": "string",
          "minLength": 1
        },
        "answers": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "fill"
                },
                "blanks": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              "required": [
                "kind",
                "blanks"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "choice"
                },
                "index": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "kind",
                "index"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "multi"
                },
                "indexes": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                }
              },
              "required": [
                "kind",
                "indexes"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "judge"
                },
                "value": {
                  "type": "boolean"
                }
              },
              "required": [
                "kind",
                "value"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "final"
                },
                "answer": {
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "answer"
              ],
              "additionalProperties": false
            }
          ]
        },
        "solutionMd": {
          "type": "string"
        }
      },
      "required": [
        "ref",
        "no",
        "present",
        "snapshotHash",
        "type",
        "difficulty",
        "knowledge",
        "stemMd"
      ],
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "properties": {
        "no": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "answerText": {
          "type": [
            "string",
            "null"
          ]
        },
        "attemptId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "studentId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "autoCorrect": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "finalCorrect": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "teacherMark": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "correct",
                "wrong"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "teacherComment": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "no",
        "answerText"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^e\\d{3,}$"
        },
        "phase": {
          "type": "string",
          "enum": [
            "scratch",
            "correction",
            "supplement"
          ]
        },
        "state": {
          "type": "string",
          "enum": [
            "none",
            "frozen",
            "missing",
            "legacy_unverified",
            "not_collected"
          ]
        },
        "images": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1
              },
              "pageIndex": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "crop": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "y": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "width": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "height": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "x",
                  "y",
                  "width",
                  "height"
                ],
                "additionalProperties": false
              },
              "pixelWidth": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "pixelHeight": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "state": {
                "type": "string",
                "enum": [
                  "ready",
                  "missing"
                ]
              }
            },
            "required": [
              "file",
              "pageIndex",
              "crop",
              "pixelWidth",
              "pixelHeight",
              "state"
            ],
            "additionalProperties": false
          }
        },
        "attemptId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "studentId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "questionId": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "object",
          "properties": {
            "versionId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "savedAt": {
              "type": "string",
              "minLength": 1
            },
            "strokeCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "pointCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "paperHeight": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "versionId",
            "savedAt",
            "strokeCount",
            "pointCount",
            "paperHeight"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "ref",
        "phase",
        "state",
        "images"
      ],
      "additionalProperties": false
    },
    "manifest": {
      "type": "object",
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "enum": [
                  "summary",
                  "prompt",
                  "schema",
                  "mapping",
                  "ink",
                  "media",
                  "evidence",
                  "question"
                ]
              },
              "bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "refs": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "path",
              "kind",
              "bytes",
              "refs"
            ],
            "additionalProperties": false
          }
        },
        "missing": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "enum": [
                  "media",
                  "evidence-image",
                  "ink"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "refs": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "path",
              "kind",
              "reason",
              "refs"
            ],
            "additionalProperties": false
          }
        },
        "contextNotes": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "files",
        "missing",
        "contextNotes"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "kind",
    "version",
    "role",
    "generatedAt",
    "question",
    "response",
    "evidence",
    "manifest"
  ],
  "additionalProperties": false
}
