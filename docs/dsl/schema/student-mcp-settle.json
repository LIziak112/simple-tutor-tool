{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "workflowVersion": {
      "type": "number",
      "const": 1
    },
    "workflowRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "mutationId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "questions": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "questionId": {
            "type": "string",
            "minLength": 1
          },
          "questionRevisionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "expectedAnswerRevision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "evidence": {
            "type": "object",
            "properties": {
              "questionId": {
                "type": "string",
                "minLength": 1
              },
              "state": {
                "type": "string",
                "enum": [
                  "none",
                  "frozen",
                  "missing"
                ]
              },
              "versionId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "revision": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "questionId",
              "state"
            ],
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "versionId": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  },
                  "revision": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "state": {
                    "const": "frozen"
                  }
                },
                "required": [
                  "versionId",
                  "revision"
                ]
              },
              {
                "properties": {
                  "state": {
                    "enum": [
                      "none",
                      "missing"
                    ]
                  }
                },
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "versionId"
                      ]
                    },
                    {
                      "required": [
                        "revision"
                      ]
                    }
                  ]
                }
              }
            ]
          }
        },
        "required": [
          "questionId",
          "questionRevisionId",
          "expectedAnswerRevision",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "practiceId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    }
  },
  "required": [
    "workflowVersion",
    "workflowRevision",
    "mutationId",
    "questions",
    "practiceId"
  ],
  "additionalProperties": false
}
