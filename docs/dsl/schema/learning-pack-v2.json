{
  "title": "simple-tutor-tool 学情数据包（LearningPack v2）",
  "description": "AI 学情数据包 pack.json（v2 证据装配，T6R.12）的权威 JSON Schema：每条逐题作答经 questionRef/snapshotHash 关联其交卷时的题目快照（同 qid 多版本一一配对）；evidence 携带逐题原稿声明与分析图附件；manifest 为 zip 文件清单与缺失清单（所有引用可解析或显式缺失）。教师评语为原文（可能含学生真实姓名）；traces 只含派生指标与阅读地图（原始事件不出库）。",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "meta": {
      "type": "object",
      "properties": {
        "version": {
          "type": "number",
          "const": 2
        },
        "generatedAt": {
          "type": "string",
          "minLength": 1
        },
        "goal": {
          "type": "string",
          "enum": [
            "diagnose-weakness",
            "lesson-prep",
            "variant-practice",
            "period-summary"
          ]
        },
        "days": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "string",
              "const": "all"
            }
          ]
        },
        "from": {
          "type": [
            "string",
            "null"
          ]
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "anonymized": {
          "type": "boolean"
        },
        "modules": {
          "type": "object",
          "properties": {
            "lectures": {
              "type": "boolean"
            },
            "questions": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "stem",
                    "answer",
                    "solution"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "responses": {
              "type": "boolean"
            },
            "summaries": {
              "type": "boolean"
            },
            "ink": {
              "type": "boolean"
            },
            "traces": {
              "type": "boolean"
            },
            "evidence": {
              "type": "boolean"
            }
          },
          "required": [
            "lectures",
            "questions",
            "responses",
            "summaries",
            "ink",
            "traces",
            "evidence"
          ],
          "additionalProperties": false
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "version",
        "generatedAt",
        "goal",
        "days",
        "from",
        "to",
        "anonymized",
        "modules",
        "note"
      ],
      "additionalProperties": false
    },
    "students": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "archived": {
            "type": "boolean"
          }
        },
        "required": [
