          "name",
          "archived"
        ],
        "additionalProperties": false
      }
    },
    "content": {
      "type": "object",
      "properties": {
        "lectures": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "lectureId": {
                "type": "string",
