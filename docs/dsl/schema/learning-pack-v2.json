                      },
                      "index": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "kind",
                      "index"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "multi"
                      },
                      "indexes": {
                        "minItems": 1,
                        "type": "array",
                        "items": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        }
                      }
                    },
                    "required": [
                      "kind",
                      "indexes"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "judge"
                      },
                      "value": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "kind",
                      "value"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "final"
                      },
                      "answer": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "kind",
                      "answer"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "solutionMd": {
                "type": "string"
              },
              "ref": {
                "type": "string",
                "pattern": "^q\\d{3,}$"
              },
              "present": {
                "type": "boolean"
              },
              "snapshotHash": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "media": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "src": {
                      "type": "string",
                      "minLength": 1
                    },
                    "present": {
                      "type": "boolean"
                    }
