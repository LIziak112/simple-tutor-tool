              },
              "answers": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "fill"
                      },
                      "blanks": {
                        "type": "array",
                        "items": {
                          "type": "array",
