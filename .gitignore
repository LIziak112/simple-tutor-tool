# 依赖
node_modules/

# 构建产物与测试覆盖率
dist/
coverage/
*.tsbuildinfo

# 运行时数据与部署产物（SQLite、blobs、备份等都在 data/）
data/
deploy/

# 环境变量与本机覆盖配置
.env
*.local
.zcode/tmp/

# 本机调试采集工件（含学生专属链接令牌，不入库）
.claude/phase3-capture/

# 个人笔记库（Obsidian，本地资料；biome useIgnoreFile=true 依赖本清单排除 .obsidian）
note/

# 库内数据修复用的源文件副本（随数据库修复同步，不进 git）
/练习六 乘法与倒数.公式修复.md

# Playwright E2E 产物（T2.13）：诊断输出与 html 报告
e2e/.artifacts/
playwright-report/

# 本地 MCP 客户端配置（含会话 Bearer 凭据），严禁入库
mcp_config.json

# e2e preview 对照实验产物（独立于生产 dist，见 apps/web/vite.config.ts）
dist-e2e-preview/

# vitest 本机运行产物（json 报告等调试输出，不入库）
.vitest/
# Node/原生崩溃转储（曾以 310MB 混入提交被 GitHub 拒收）
/core
